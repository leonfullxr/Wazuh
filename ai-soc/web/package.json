    "@vitejs/plugin-react": "6.0.1",
    "autoprefixer": "10.6.1",
    "openapi-typescript": "7.13.0",
    "postcss": "8.5.31",
    "prettier": "3.6.2",
    "tailwindcss": "4.3.3",
