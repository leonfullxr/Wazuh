    "validators:check": "node scripts/generate-validators.mjs --check",
    "preview": "vite preview --mode live",
    "workspace-types:generate": "node scripts/generate-workspace-types.mjs",
    "workspace-types:check": "node scripts/generate-workspace-types.mjs --check",
    "workspace-validators:generate": "node scripts/generate-workspace-validators.mjs",
    "workspace-validators:check": "node scripts/generate-workspace-validators.mjs --check"
  },
  "dependencies": {
    "@fontsource-variable/inter": "5.2.6",
