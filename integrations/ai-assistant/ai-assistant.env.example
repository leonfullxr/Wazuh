# Copy to ai-assistant.env and fill in values before install.
DEPLOYMENT_TYPE=all-in-one

# Wazuh indexer (OpenSearch)
WAZUH_INDEXER_IP=127.0.0.1
WAZUH_INDEXER_USER=admin
WAZUH_INDEXER_PASS=CHANGE_ME
WAZUH_INDEXER_VERIFY_TLS=true

# Wazuh manager (agent restart actions)
WAZUH_MANAGER_IP=127.0.0.1
WAZUH_MANAGER_PORT=55000
WAZUH_MANAGER_USER=wazuh-wui
WAZUH_MANAGER_PASS=CHANGE_ME

# Wazuh dashboard (saved-object actions)
WAZUH_DASHBOARD_IP=127.0.0.1
WAZUH_DASHBOARD_USER=admin
WAZUH_DASHBOARD_PASS=CHANGE_ME

# OpenSearch MCP server (upstream opensearch-mcp-server-py, SSE)
MCP_SERVER_HOST=0.0.0.0
MCP_SERVER_PORT=9900
MCP_SSE_URL=http://127.0.0.1:9900/mcp

# MCP-LLM gateway (ML Commons connector target)
GATEWAY_HOST=0.0.0.0
GATEWAY_PORT=9912
GATEWAY_PUBLIC_HOST=127.0.0.1
GATEWAY_API_KEY=CHANGE_ME

# LLM provider: openai | gemini | claude_bedrock | openai_compatible
LLM_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
AWS_REGION=us-east-1
BEDROCK_MODEL_ID=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
OPENAI_COMPATIBLE_BASE_URL=
OPENAI_COMPATIBLE_MODEL=
OPENAI_COMPATIBLE_API_KEY=

# SMTP (PDF report action)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
